@model DesafioBenjamin.Models.Questao
@{
    ViewData["Title"] = "Editar questao";
    var alternativas = Model.Alternativas.OrderBy(a => a.Id).ToList();
    bool utilizada = ViewBag.Utilizada is bool valor && valor;
}
<div class="container py-4">
    <h1>Editar questao #@Model.Id</h1>
    <p><a href="/laboratorio-ia/aprovadas">Voltar a consulta</a></p>
    @if (TempData["Erro"] is string erro) { <div class="alert alert-warning">@erro</div> }
    @if (utilizada)
    {
        <div class="alert alert-warning">Esta questao ja foi utilizada em uma partida. A edicao esta bloqueada para preservar respostas e resultados historicos. Desative-a na consulta e crie uma nova versao corrigida.</div>
    }
    <form method="post" action="/laboratorio-ia/editar/@Model.Id">
        @Html.AntiForgeryToken()
        <label for="enunciado" class="form-label">Enunciado</label>
        <textarea id="enunciado" name="enunciado" rows="2" maxlength="2000" class="form-control mb-3" required disabled="@utilizada">@Model.Enunciado</textarea>
        @for (int i = 0; i < alternativas.Count; i++)
        {
            <label class="form-label" for="alternativa-@i">Alternativa @(i + 1)</label>
            <textarea id="alternativa-@i" name="alternativas" class="form-control mb-2" maxlength="1000" required disabled="@utilizada">@alternativas[i].Texto</textarea>
        }
        <label for="indiceCorreto" class="form-label">Alternativa correta</label>
        <select id="indiceCorreto" name="indiceCorreto" class="form-select mb-3" disabled="@utilizada">
            @for (int i = 0; i < alternativas.Count; i++)
            {
                <option value="@i" selected="@alternativas[i].Correta">Alternativa @(i + 1)</option>
            }
        </select>
        <label for="explicacao" class="form-label">Explicacao</label>
        <textarea id="explicacao" name="explicacao" class="form-control mb-3" rows="3" maxlength="4000" required disabled="@utilizada">@Model.Explicacao</textarea>
        @if (!utilizada) { <button class="btn btn-primary" type="submit">Salvar alteracoes</button> }
    </form>
</div>
