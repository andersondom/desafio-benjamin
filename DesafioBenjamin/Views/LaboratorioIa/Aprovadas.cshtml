@model List<DesafioBenjamin.Models.Questao>
@{
    ViewData["Title"] = "Questoes cadastradas";
    var questionarios = ViewBag.Questionarios as List<DesafioBenjamin.Models.Questionario> ?? new();
    int? selecionado = ViewBag.QuestionarioId as int?;
}
<div class="container py-4">
    <h1>Questoes cadastradas</h1>
    <p class="text-muted">Consulta local das ultimas 100 questoes cadastradas. Inclui questoes anteriores e adicionadas pelo laboratorio; ainda nao ha marcacao de origem por IA.</p>
    <p><a href="/laboratorio-ia" class="btn btn-outline-primary">Voltar ao laboratorio</a></p>
    <form method="get" action="/laboratorio-ia/aprovadas" class="mb-4">
        <label for="questionarioId" class="form-label">Filtrar por questionario</label>
        <select id="questionarioId" name="questionarioId" class="form-select mb-2">
            <option value="">Todos</option>
            @foreach (var q in questionarios)
            {
                <option value="@q.Id" selected="@(selecionado == q.Id)">@q.Titulo</option>
            }
        </select>
        <button class="btn btn-primary" type="submit">Consultar</button>
    </form>
    @if (TempData["Sucesso"] is string sucesso) { <div class="alert alert-success">@sucesso</div> }
    @if (Model.Count == 0)
    {
        <p class="alert alert-info">Nenhuma questao encontrada para este filtro.</p>
    }
    @foreach (var q in Model)
    {
        <article class="card mb-3">
            <div class="card-body">
                <p class="text-muted mb-1">Questao #@q.Id — @q.Questionario.Titulo — <strong>@(q.Ativa ? "Ativa" : "Inativa")</strong></p>
                <h2 class="h5">@q.Enunciado</h2>
                <ol type="A">
                    @foreach (var a in q.Alternativas.OrderBy(a => a.Id))
                    {
                        <li class="mb-1"> @a.Texto @if (a.Correta) { <strong class="text-success">(correta)</strong> } </li>
                    }
                </ol>
                <p><strong>Explicacao:</strong> @q.Explicacao</p>
                <a class="btn btn-outline-primary btn-sm" href="/laboratorio-ia/editar/@q.Id">Consultar / editar</a>
                <form method="post" action="/laboratorio-ia/alternar/@q.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-warning btn-sm">@(q.Ativa ? "Desativar" : "Reativar")</button>
                </form>
            </div>
        </article>
    }
</div>
