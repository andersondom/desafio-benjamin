<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DesafioBenjamin</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DesafioBenjamin.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3" aria-label="Navegação principal">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🤖 Desafio Benjamin 2.0</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuBenjamin"
                        aria-controls="menuBenjamin" aria-expanded="false" aria-label="Abrir menu de navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuBenjamin">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">🏠 Início e desafios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="RevisaoInteligente" asp-action="Index">🧠 Revisão inteligente</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="menuAdministracao" role="button" data-bs-toggle="dropdown" aria-expanded="false">⚙️ Administração</a>
                            <ul class="dropdown-menu" aria-labelledby="menuAdministracao">
                                <li><a class="dropdown-item" href="/laboratorio-ia">🤖 Laboratório de IA</a></li>
                                <li><a class="dropdown-item" href="/laboratorio-ia/aprovadas">📚 Questões aprovadas</a></li>
                                <li><a class="dropdown-item" href="/painel-pedagogico">📊 Painel pedagógico</a></li>
                            </ul>
                        </li>
                    </ul>
                    @if (User.IsInRole("Administrador"))
                    {
                        <form method="post" action="/administracao/sair" class="d-flex">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">🔒 Sair da administração</button>
                        </form>
                    }
                    else
                    {
                        <a href="/administracao/entrar" class="btn btn-outline-primary btn-sm">🔐 Entrar como administrador</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DesafioBenjamin - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
