@model DesafioBenjamin.Models.Tentativa

@{
    ViewData["Title"] = "Resultado";
    var mensagem = Model.PercentualAcertos >= 80
        ? "Excelente trabalho!"
        : Model.PercentualAcertos >= 60
            ? "Muito bem! Continue praticando."
            : "Cada tentativa é uma oportunidade de aprender!";
}

<div class="container py-5" style="max-width:760px">
    <div class="card shadow border-0 text-center">
        <div class="card-body p-5">
            <div style="font-size:80px">🏆</div>
            <h1 class="fw-bold">Desafio concluído!</h1>
            <h3 class="mt-3">@mensagem, Benjamin! 🌟</h3>

            <div class="row g-3 my-4">
                <div class="col-4"><div class="p-3 bg-light rounded-3"><strong class="fs-3">@Model.TotalAcertos</strong><br><span>Acertos</span></div></div>
                <div class="col-4"><div class="p-3 bg-light rounded-3"><strong class="fs-3">@Model.TotalErros</strong><br><span>Erros</span></div></div>
                <div class="col-4"><div class="p-3 bg-light rounded-3"><strong class="fs-3">@Model.PercentualAcertos%</strong><br><span>Aproveitamento</span></div></div>
            </div>

            <p class="text-muted">@Model.Questionario.Titulo • @Model.Questionario.Capitulo</p>

            <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">🏠 Início</a>
                <a asp-action="Index" asp-route-id="@Model.QuestionarioId" class="btn btn-success btn-lg">🎮 Jogar novamente</a>
            </div>
        </div>
    </div>
</div>
